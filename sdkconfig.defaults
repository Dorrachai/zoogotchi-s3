# =============================================================================
# ZooGotchi S3 — ESP-IDF sdkconfig overrides
# Merged by PlatformIO during the build.
# =============================================================================

# SPIRAM: allow WiFi and LwIP internal buffers to allocate from PSRAM first.
# Keeps internal DRAM free for the PLE Micro-LLM scratch activations & HTTP SSE.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
